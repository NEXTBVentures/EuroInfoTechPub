{
  "name": "@workspace/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:pg-boss --external:pg --external:@prisma/adapter-pg --external:@prisma/client/* --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "enqueue-smoke": "tsx src/enqueue-smoke.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@workspace/adapters": "workspace:*",
    "@workspace/core": "workspace:*",
    "@workspace/database": "workspace:*",
    "pg": "8.16.3",
    "pg-boss": "12.37.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.27.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
